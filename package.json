{
  "name": "swc-decorators-plugin",
  "version": "0.0.0",
  "description": "Vite plugin that uses SWC only for modules containing standard decorators",
  "homepage": "https://github.com/js2me/swc-decorators-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/js2me/swc-decorators-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/js2me/swc-decorators-plugin/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "swc",
    "decorators",
    "standard-decorators",
    "stage-3-decorators",
    "typescript",
    "javascript",
    "class-fields",
    "rolldown"
  ],
  "author": {
    "name": "js2me",
    "url": "https://github.com/js2me"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@swc/core": "^1.15.33"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.10.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.7"
  }
}
